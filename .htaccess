# Protect Intake Form from Public Access
# This file should be placed in the root directory if using Apache

# Block access to intake files (uncomment if you want to block entirely)
# <FilesMatch "^(intake\.html|intake\.css|intake\.js)$">
#     Require all denied
# </FilesMatch>

# Prevent directory listing
Options -Indexes

# Block access to sensitive files
<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|bak)$">
    Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Prevent caching of intake form (REQUIRED - always reload)
<FilesMatch "^(intake\.html|intake\.css|intake\.js)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </IfModule>
</FilesMatch>

# Remove .html extension from URLs
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Redirect .html URLs to clean URLs (301 permanent redirect)
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]
    
    # Internally rewrite clean URLs to .html files if they exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]
    
    # Handle root/index
    RewriteCond %{REQUEST_URI} ^/$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.html [L]
</IfModule>

