---
/**
 * Base layout for justaweb.agency pages.
 *
 * WHY: one place for the head (SEO, social cards, structured data), analytics and the
 * theme bootstrap, so every page is consistent and the homepage stays readable.
 *
 * HOW:
 *  - The theme script runs inline before paint: it reads localStorage "theme" (the same
 *    key the legacy script.js uses) or falls back to the OS setting, and sets
 *    data-theme on <html> so there is no light/dark flash.
 *  - GA4 (G-K58RVS4CZQ) and Google Ads (AW-611239252) are the same tags the old page
 *    shipped. gtag.js is loaded once and configured for both ids (the old page loaded it
 *    twice). `gtagSendConversionEvent` is kept with the same name and conversion label so
 *    the Ads lead conversion keeps counting.
 */
import "../styles/global.css";

import { CONTACT, PRICING } from "../data/site.js";

interface Props {
  title: string;
  description: string;
  /** Keep utility pages (thank-you screens) out of search results. */
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page (e.g. the homepage FAQPage), merged into @graph. */
  schema?: Record<string, unknown>[];
}
const { title, description, noindex = false, schema = [] } = Astro.props;

/**
 * Canonical URL. Astro builds with format "file", so Astro.url.pathname can end in
 * ".html" (and the homepage in "/index.html"). Netlify serves every page at its clean
 * URL, which is also what our links, sitemap and llms.txt use, so the canonical is the
 * clean form: "/" for the homepage, "/privacy" for privacy.html.
 */
const cleanPath = Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "") || "/";
const canonical = new URL(cleanPath, Astro.site).href;

/**
 * Structured data (schema.org JSON-LD) describing the agency, for Google and AI search.
 *
 * WHY: AI answers and Google's local results lean on clear, machine-readable facts about
 * a business. This is the same groundwork JustAWeb sells, so the agency's own site shows
 * it. Every value here must match what the page visibly says (Google's structured data
 * rule): name, email, city and ZIP (no street address is claimed, per Blake), service
 * area, founder and the two real prices from site.js.
 *
 * HOW: one @graph with stable @ids so the nodes reference each other: the WebSite, the
 * business (ProfessionalService, a LocalBusiness subtype), and its founder. Pages add
 * their own nodes through the `schema` prop (the homepage adds FAQPage). sameAs is left
 * out on purpose: JustAWeb has no real social profiles yet, and an invented one would be
 * worse than none. scripts/check-seo.mjs validates the output after every build.
 */
const SITE = "https://justaweb.agency";

/** Share image (absolute URL, as Open Graph requires) and its alt text. */
const OG_IMAGE = `${SITE}/og/justaweb-card.png`;
const OG_ALT = "JustAWeb logo: the j. mark and the justaweb.agency wordmark";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE}/#website`,
      url: `${SITE}/`,
      name: "JustAWeb",
      alternateName: "justaweb.agency",
      inLanguage: "en-US",
      publisher: { "@id": `${SITE}/#business` },
    },
    {
      "@type": "ProfessionalService",
      "@id": `${SITE}/#business`,
      name: "JustAWeb",
      url: `${SITE}/`,
      email: CONTACT.email,
      logo: `${SITE}/logos/justaweb-logo-full.png`,
      image: `${SITE}/logos/justaweb-logo-full.png`,
      description:
        "Fast, custom websites for small businesses in Vancouver, WA, Portland, OR and beyond, built to be found on Google and in AI search. $1,000 flat, the owner keeps every file, and hosting with edits is an optional $250 a year.",
      slogan: "A real website for your business. Yours to keep.",
      priceRange: "$$",
      currenciesAccepted: "USD",
      paymentAccepted: "Venmo, Zelle",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Vancouver",
        addressRegion: "WA",
        postalCode: "98683",
        addressCountry: "US",
      },
      areaServed: [
        { "@type": "City", name: "Vancouver", containedInPlace: { "@type": "State", name: "Washington" } },
        { "@type": "City", name: "Portland", containedInPlace: { "@type": "State", name: "Oregon" } },
      ],
      founder: { "@id": `${SITE}/#blake` },
      knowsAbout: [
        "Small business websites",
        "Local SEO",
        "Generative engine optimization (AI search)",
        "Structured data",
        "Web accessibility",
      ],
      makesOffer: [
        {
          "@type": "Offer",
          name: "Custom small business website",
          description: "Custom design and build, mobile first, contact form, tap-to-call, map and hours, Google-ready SEO basics, built to be found in AI search. The owner keeps all code and files.",
          price: String(PRICING.site),
          priceCurrency: "USD",
          url: `${SITE}/#pricing`,
          availability: "https://schema.org/InStock",
        },
        {
          "@type": "Offer",
          name: "Hosting and edits (optional)",
          description: "Fast hosting plus text, photo and page updates on request. Billed once a year, cancel anytime.",
          price: String(PRICING.hosting),
          priceCurrency: "USD",
          url: `${SITE}/#pricing`,
          priceSpecification: {
            "@type": "UnitPriceSpecification",
            price: String(PRICING.hosting),
            priceCurrency: "USD",
            unitText: "year",
            referenceQuantity: { "@type": "QuantitativeValue", value: 1, unitCode: "ANN" },
          },
        },
      ],
    },
    {
      "@type": "Person",
      "@id": `${SITE}/#blake`,
      name: "Blake Goble",
      jobTitle: "Founder, web designer and developer",
      worksFor: { "@id": `${SITE}/#business` },
      email: CONTACT.email,
    },
    ...schema,
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111317" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="JustAWeb" />
    <!-- Share card: the JustAWeb logo on every page (Blake, 2026-09-28). One fixed image,
         no per-page overrides. Source: scripts/og-card.html; check-seo.mjs verifies these
         tags on every built page, including the private tools in public/. -->
    <meta property="og:image" content={OG_IMAGE} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <meta name="twitter:image:alt" content={OG_ALT} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Set the theme before first paint. Same storage key as legacy public/script.js.
      (function () {
        var t = null;
        try { t = localStorage.getItem("theme"); } catch (e) {}
        if (t !== "light" && t !== "dark") t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
      })();
      /**
       * Motion opt-in, also before first paint. Adds html.motion only when the visitor
       * allows motion and IntersectionObserver exists; every hide-then-reveal style in
       * global.css hangs off that class, so without it the page is simply static.
       * Failsafe: if the reveal script at the end of <body> has not reported in within
       * 3s of DOMContentLoaded, drop the class so no section can stay invisible.
       */
      (function () {
        var root = document.documentElement;
        if (!("IntersectionObserver" in window) || !matchMedia("(prefers-reduced-motion: no-preference)").matches) return;
        root.classList.add("motion");
        document.addEventListener("DOMContentLoaded", function () {
          setTimeout(function () { if (!window.__jawReveal) root.classList.remove("motion"); }, 3000);
        });
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Google tag: GA4 + Google Ads, loaded once, async so it never blocks rendering. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-K58RVS4CZQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      var linker = { linker: { domains: ["justaweb.agency", "justawebagency.netlify.app"] } };
      gtag("config", "G-K58RVS4CZQ", linker);
      gtag("config", "AW-611239252", linker);
      /**
       * Report a lead-form conversion to Google Ads, then run `callback` (for example the
       * real form submit). event_timeout guarantees the callback runs even if gtag is
       * blocked by an ad blocker, so a lead is never lost to tracking.
       */
      function gtagSendConversionEvent(callback) {
        gtag("event", "ads_conversion_submit_lead_form", {
          event_callback: callback || function () {},
          event_timeout: 2000,
          send_to: "AW-611239252/xMSMCNyr6uobENSKu6MC",
          value: 1.0,
          currency: "USD",
        });
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    <script is:inline>
      /**
       * Scroll reveals. Inline (not bundled) so it runs as soon as the HTML is parsed,
       * with no extra request that could be slow or blocked.
       *
       * HOW: every .reveal is observed. Items that enter the viewport in the same batch
       * get a growing --reveal-delay (80ms apart, capped) so a row of cards cascades
       * instead of arriving as one slab. Items already above the viewport (deep links,
       * restored scroll) are shown immediately. Each item reveals once, then is
       * unobserved. If the visitor switches on reduced motion mid-visit, everything is
       * shown and html.motion is dropped.
       */
      (function () {
        var root = document.documentElement;
        window.__jawReveal = true;
        if (!root.classList.contains("motion")) return;
        var items = document.querySelectorAll(".reveal");
        var io = new IntersectionObserver(function (entries) {
          var n = 0;
          entries.forEach(function (e) {
            var above = e.boundingClientRect.bottom < 0;
            if (!e.isIntersecting && !above) return;
            var el = e.target;
            el.style.setProperty("--reveal-delay", above ? "0ms" : Math.min(n++, 5) * 80 + "ms");
            if (above) el.style.animation = "none";
            el.classList.add("is-in");
            io.unobserve(el);
          });
        }, { rootMargin: "0px 0px -8% 0px" });
        items.forEach(function (el) { io.observe(el); });
        matchMedia("(prefers-reduced-motion: reduce)").addEventListener("change", function (m) {
          if (m.matches) { root.classList.remove("motion"); io.disconnect(); }
        });
      })();
    </script>
  </body>
</html>
